<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200" fill="none">
  <defs>
    <linearGradient id="aiHexGrad" x1="20" y1="20" x2="180" y2="180" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#9333EA" />
      <stop offset="50%" stop-color="#7C3AED" />
      <stop offset="100%" stop-color="#4F46E5" />
    </linearGradient>
    <linearGradient id="glowLine" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#C084FC" />
      <stop offset="100%" stop-color="#818CF8" />
    </linearGradient>
    <linearGradient id="carBodyGrad" x1="50" y1="100" x2="150" y2="150" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#E2E8F0" />
    </linearGradient>
    <filter id="aiGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#7C3AED" flood-opacity="0.45" />
    </filter>
  </defs>

  <!-- Hexagonal Tech Speech Bubble Outer Frame -->
  <path d="M100 16 L168 54 L168 128 L116 166 L110 188 L90 166 L32 128 L32 54 Z" 
        fill="url(#aiHexGrad)" 
        filter="url(#aiGlow)" />

  <!-- Inner Dark Canvas with Alpha -->
  <path d="M100 28 L156 60 L156 122 L112 152 L106 170 L94 152 L44 122 L44 60 Z" 
        fill="#0F172A" />

  <!-- Neural Circuit Traces -->
  <!-- Center Node -->
  <line x1="100" y1="52" x2="100" y2="92" stroke="url(#glowLine)" stroke-width="3" stroke-linecap="round" />
  <circle cx="100" cy="50" r="5.5" fill="#C084FC" />
  <circle cx="100" cy="50" r="2.5" fill="#FFFFFF" />

  <!-- Left Node -->
  <path d="M68 66 L86 66 L94 88" stroke="url(#glowLine)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="68" cy="66" r="4.5" fill="#A855F7" />
  <circle cx="68" cy="66" r="2" fill="#FFFFFF" />

  <!-- Right Node -->
  <path d="M132 66 L114 66 L106 88" stroke="url(#glowLine)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="132" cy="66" r="4.5" fill="#818CF8" />
  <circle cx="132" cy="66" r="2" fill="#FFFFFF" />

  <!-- Modern Automotive Sports Silhouette -->
  <!-- Car Roof & Windshield -->
  <path d="M68 116 C74 100, 86 94, 100 94 C114 94, 126 100, 132 116 Z" 
        fill="#1E293B" 
        stroke="url(#glowLine)" 
        stroke-width="2" />
  
  <!-- Windshield Reflection -->
  <path d="M78 114 C82 103, 90 98, 100 98 C104 98, 108 99, 112 101" 
        stroke="#A855F7" 
        stroke-width="1.8" 
        stroke-linecap="round" />

  <!-- Car Main Body -->
  <path d="M54 126 C54 120, 60 116, 68 116 L132 116 C140 116, 146 120, 146 126 L144 136 C144 140, 140 142, 134 142 L66 142 C60 142, 56 140, 56 136 Z" 
        fill="url(#carBodyGrad)" />

  <!-- Side Mirrors -->
  <path d="M52 120 L58 122 L58 126 Z" fill="#E2E8F0" />
  <path d="M148 120 L142 122 L142 126 Z" fill="#E2E8F0" />

  <!-- Sleek LED Headlights (Glowing Cyan-White) -->
  <polygon points="62,126 78,126 74,130 62,128" fill="#38BDF8" />
  <polygon points="138,126 122,126 126,130 138,128" fill="#38BDF8" />

  <!-- Lower Intake Grill -->
  <path d="M84 134 L116 134 L112 138 L88 138 Z" fill="#0F172A" />
</svg>